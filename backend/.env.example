PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://admin_ap:ap_password2026@localhost:5432/cuentas_por_pagar_db?schema=public
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Correo (Mailpit en desarrollo; bandeja web en http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Dashboard AP <no-reply@dashboard-ap.local>"

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_TZ=America/Santiago
ALERTAS_CRON=*/5 * * * *
ALERTA_TAREA_DIAS_ANTES=0
ALERTA_ROTACION_HORAS=72
ROTACION_AUTO_GENERAR=true
ROTACION_CRON=0 18 * * 5

# Documentos (en Docker el volumen ./backend/uploads se monta en /app/uploads)
UPLOADS_DIR=./uploads
MAX_UPLOAD_MB=15
