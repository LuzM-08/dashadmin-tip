FROM node:22-alpine

# openssl: requerido por Prisma en Alpine. tini: manejo correcto de señales y procesos.
RUN apk add --no-cache openssl tini

ENV NODE_ENV=production
WORKDIR /app

COPY package*.json ./
COPY prisma ./prisma
# Se incluyen las dependencias de desarrollo porque el contenedor ejecuta `prisma migrate deploy` al arrancar.
RUN npm install --include=dev --no-audit --no-fund && npx prisma generate

COPY . .
RUN mkdir -p /app/uploads && chown -R node:node /app
USER node

EXPOSE 4000
ENTRYPOINT ["/sbin/tini", "--"]
# Aplica migraciones pendientes y arranca; `exec` deja a Node como proceso principal (recibe SIGTERM).
CMD ["sh", "-c", "npx prisma migrate deploy && exec node src/server.js"]
